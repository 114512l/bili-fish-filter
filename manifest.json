{
  "manifest_version": 3,
  "name": "大肥鱼~一网打尽！",
  "version": "1.0.0",
  "description": "识别 B站 评论区里低等级、@某人、长文模板的疑似 AI 养鱼评论，折叠成占位条；顶部面板可展开列表、逐个定位、一键重折。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "大肥鱼~一网打尽！",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
